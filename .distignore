# Paths excluded from the installable plugin zip.
# One pattern per line. Matching is against the repo-relative path.
# Directory names match the directory itself and everything under it.
# Leading "./" is optional. "#" starts a comment.

.git
.github
.agents
.vscode
.worktrees
.DS_Store
.gitignore
.wp-env.json
.wp-env.override.json
.phpunit.result.cache
.phpunit.cache
.distignore

